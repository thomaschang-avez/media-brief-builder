# ── Glean ─────────────────────────────────────────────────────────
GLEAN_SERVER_URL=https://your-company-be.glean.com
GLEAN_API_TOKEN=your-glean-api-token
GLEAN_ACT_AS=you@yourcompany.com

# ── Google Cloud / Vertex AI ──────────────────────────────────────
GEMINI_PROJECT=your-gcp-project-id
GEMINI_LOCATION=us-central1

# Google Drive service account credentials (base64-encoded ADC JSON)
# Run: base64 -i ~/.config/gcloud/application_default_credentials.json | tr -d '\n'
DRIVE_ADC_BASE64=

# ── Google Drive ──────────────────────────────────────────────────
# Folder ID where completed briefs are saved
PR_BRIEFS_FOLDER_ID=your-google-drive-folder-id

# Folder ID containing example briefs (used for few-shot context)
MEDIA_BRIEF_EXAMPLES_FOLDER=your-examples-folder-id

# ── Slack ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_FALLBACK_USER_ID=UXXXXXXXXXX
SLACK_ADMIN_USER_ID=UXXXXXXXXXX
SLACK_ERROR_CHANNEL=CXXXXXXXXXX
SLACK_TEST_CHANNEL=CXXXXXXXXXX

# ── Serper (web search) ───────────────────────────────────────────
SERPER_API_KEY=your-serper-api-key

# ── Misc ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourcompany.com
PORT=8080
